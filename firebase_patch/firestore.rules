rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function signedInUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function signedInUserRoles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles is list
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
        : [];
    }

    function hasSignedInUserRole(role) {
      return signedInUserRole() == role || role in signedInUserRoles();
    }

    function hasTokenRole(role) {
      return request.auth.token.keys().hasAny(['role'])
        && request.auth.token.role == role;
    }

    function isAdmin() {
      return isAuthenticated()
        && (hasTokenRole('admin')
          || hasTokenRole('super_admin')
          || hasSignedInUserRole('admin')
          || hasSignedInUserRole('super_admin'));
    }

    function isCommunityAdmin() {
      return isAuthenticated()
        && (hasTokenRole('community_admin')
          || hasSignedInUserRole('community_admin'));
    }

    function isJudge() {
      return isAuthenticated()
        && (hasTokenRole('judge')
          || hasSignedInUserRole('judge'));
    }

    function isPlayer() {
      return isAuthenticated()
        && (hasTokenRole('player')
          || hasTokenRole('community_admin')
          || hasTokenRole('judge')
          || hasTokenRole('admin')
          || hasTokenRole('super_admin')
          || hasSignedInUserRole('player')
          || hasSignedInUserRole('community_admin')
          || hasSignedInUserRole('judge')
          || hasSignedInUserRole('admin')
          || hasSignedInUserRole('super_admin'));
    }

    function isSelf(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function canCommunityManageJudgeRole(uid) {
      return isCommunityAdmin()
        && request.auth.uid != uid
        && resource.data.role in ['player', 'judge']
        && request.resource.data.role in ['player', 'judge']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'role',
            'roles',
            'judgeAssignedBy',
            'judgeAssignedAt',
            'judgeRevokedBy',
            'judgeRevokedAt',
            'updatedAt'
          ]);
    }

    function canJudgeAdvanceTournament() {
      return isJudge()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'currentRoundId',
            'winnerId',
            'winnerName',
            'finalScore',
            'completedAt',
            'judgeCheckIns',
            'updatedAt'
          ]);
    }

    function canUpdateRegistrationOps(tournamentId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'paymentStatus',
            'registrationStatus',
            'paymentId',
            'paidAt',
            'paidBy',
            'paidByName',
            'activatedAt',
            'walkOutAt',
            'updatedAt'
          ]);
    }

    // ── /users/{uid} ──────────────────────────────────────────────
    function canUpdateTournamentOps() {
      return isAuthenticated()
        && resource.data.organizerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'currentParticipantCount',
            'currentStage',
            'currentRoundId',
            'stageStatus',
            'roundRobin',
            'topCut',
            'bracketSize',
            'seededMatchCount',
            'activeMatchCount',
            'byeCount',
            'organizerPayout',
            'staffIds',
            'startedAt',
            'updatedAt'
          ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status in ['draft', 'registrationOpen', 'ready', 'running']);
    }

    function isTournamentOrganizer(tournamentId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid;
    }

    function isTournamentStaff(tournamentId) {
      return isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('staffIds', []);
    }

    function canStaffRunRegistrationOps(tournamentId) {
      return isTournamentStaff(tournamentId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'paymentStatus',
            'registrationStatus',
            'paymentId',
            'paidAt',
            'paidBy',
            'paidByName',
            'activatedAt',
            'walkOutAt',
            'checkInStatus',
            'updatedAt'
          ]);
    }

    function canStaffRunTournamentOps(tournamentId) {
      return isTournamentStaff(tournamentId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'currentParticipantCount',
            'currentStage',
            'currentRoundId',
            'stageStatus',
            'roundRobin',
            'topCut',
            'bracketSize',
            'seededMatchCount',
            'activeMatchCount',
            'byeCount',
            'startedAt',
            'updatedAt'
          ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status in ['draft', 'registrationOpen', 'ready', 'running']);
    }

    function isTournamentOwner(tournamentId) {
      return isCommunityAdmin()
        && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid;
    }

    function isNewTournamentOwner() {
      return isCommunityAdmin()
        && request.resource.data.organizerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid)
        || isAdmin()
        || isJudge()
        || (isCommunityAdmin() && resource.data.role in ['player', 'judge']);
      allow create: if isAdmin()
        || (isSelf(uid)
          && request.resource.data.role == 'player'
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'name', 'email', 'region', 'role', 'roles',
            'eloRating', 'totalWins', 'totalLosses', 'totalMatches',
            'isQrActivated', 'isActive', 'createdAt', 'updatedAt'
          ])
          && (!('roles' in request.resource.data)
            || request.resource.data.roles == ['player']));
      allow update: if isAdmin()
        || canCommunityManageJudgeRole(uid)
        || (isSelf(uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'role',
              'roles',
              'communityIds',
              'isQrActivated',
              'eloRating',
              'totalWins',
              'totalLosses',
              'totalMatches'
            ]));
      // role, roles, communityIds, isQrActivated, and player stats are changed
      // by Cloud Functions/admin only.

      // Personal deck builder data owned by the user.
      match /decks/{deckId} {
        allow read: if isSelf(uid) || isAdmin() || isJudge();
        allow create: if isSelf(uid)
          && request.resource.data.ownerId == uid;
        allow update: if isSelf(uid)
          && resource.data.ownerId == uid
          && request.resource.data.ownerId == uid;
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    // â”€â”€ /communityApplications/{id} â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /communityApplications/{applicationId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.requesterId == request.auth.uid)
        || (isAuthenticated() && resource.data.leaderUserId == request.auth.uid);
      allow create: if isAdmin()
        || (isAuthenticated()
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    // â”€â”€ /communities/{id} â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /communities/{communityId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isCommunityAdmin()
          && request.auth.uid in resource.data.adminIds);
    }

    // ── /tournaments/{id} ────────────────────────────────────────
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isAdmin() || isNewTournamentOwner();
      allow update: if isAdmin()
        || canUpdateTournamentOps()
        || canJudgeAdvanceTournament()
        || canStaffRunTournamentOps(tournamentId);
      allow delete: if isAdmin();

      // Registrations — player creates own, admin can read/update all
      match /registrations/{regId} {
        allow read: if isAuthenticated();
        allow create: if isPlayer() && request.resource.data.playerId == request.auth.uid;
        allow update: if isAdmin()
          || canUpdateRegistrationOps(tournamentId)
          || canStaffRunRegistrationOps(tournamentId)
          || (isJudge()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'checkInStatus',
                'deckVerificationStatus',
                'judgeChecks',
                'lastJudgeActionAt',
                'updatedAt'
              ]));
        allow delete: if isAdmin();
      }

      // Payments — only Cloud Functions write via Admin SDK; player/admin can read
      match /payments/{payId} {
        allow read: if isAdmin() || (isPlayer() && resource.data.playerId == request.auth.uid);
        allow write: if isAdmin(); // Cloud Functions/admin back office
      }

      match /withdrawals/{withdrawId} {
        allow read: if isAdmin()
          || (isCommunityAdmin() && resource.data.requesterId == request.auth.uid);
        allow create: if isAdmin()
          || (isTournamentOwner(tournamentId)
            && request.resource.data.requesterId == request.auth.uid);
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      // Rounds — admin creates, all authenticated can read
      match /rounds/{roundId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin()
          || isTournamentOwner(tournamentId)
          || isTournamentOrganizer(tournamentId)
          || isTournamentStaff(tournamentId);

        // Matches — admin creates, judge updates (their assigned match), all read
        match /matches/{matchId} {
          allow read: if isAuthenticated();
          allow create: if isAdmin()
            || isTournamentOwner(tournamentId)
            || isTournamentOrganizer(tournamentId)
            || isTournamentStaff(tournamentId);
          allow update: if isAdmin()
            || isTournamentOwner(tournamentId)
            || isTournamentOrganizer(tournamentId)
            || isTournamentStaff(tournamentId)
            || (isJudge() && resource.data.judgeId == request.auth.uid);

          // Battles — only the assigned judge can create; all can read
          match /battles/{battleId} {
            allow read: if isAuthenticated();
            allow create: if isJudge() && get(/databases/$(database)/documents/tournaments/$(tournamentId)/rounds/$(roundId)/matches/$(matchId)).data.judgeId == request.auth.uid;
            allow update, delete: if false;
          }
        }

        // Standings (round robin) — organizer/staff/judge maintain rows
        match /standings/{playerId} {
          allow read: if isAuthenticated();
          allow create: if isAdmin()
            || isTournamentOwner(tournamentId)
            || isTournamentOrganizer(tournamentId)
            || isTournamentStaff(tournamentId)
            || (isJudge()
              && request.resource.data.keys().hasOnly([
                'playerId',
                'playerName',
                'groupName',
                'matches',
                'wins',
                'losses',
                'points',
                'scoreFor',
                'scoreAgainst',
                'pointDiff',
                'updatedAt'
              ]));
          allow update: if isAdmin()
            || isTournamentOwner(tournamentId)
            || isTournamentOrganizer(tournamentId)
            || isTournamentStaff(tournamentId)
            || (isJudge()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'playerId',
                  'playerName',
                  'groupName',
                  'matches',
                  'wins',
                  'losses',
                  'points',
                  'scoreFor',
                  'scoreAgainst',
                  'pointDiff',
                  'updatedAt'
                ]));
          allow delete: if isAdmin();
        }
      }

      // Brackets — admin writes, all read
      match /brackets/{bracketId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // ── /stadiums/{id} ───────────────────────────────────────────
    match /stadiums/{stadiumId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── /decks/{id} ──────────────────────────────────────────────
    match /decks/{deckId} {
      allow read: if isAuthenticated() &&
        (resource.data.playerId == request.auth.uid || isAdmin() || isJudge());
      allow create: if isPlayer() && request.resource.data.playerId == request.auth.uid;
      allow update: if (isPlayer() && resource.data.playerId == request.auth.uid)
        || isAdmin()
        || (isJudge()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'verificationStatus',
              'deckVerificationStatus',
              'judgeChecks',
              'lastJudgeActionAt',
              'updatedAt'
            ]));
      allow delete: if isAdmin();
    }

    // ── /components/{id} ─────────────────────────────────────────
    match /components/{componentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /componentStats/{componentId} {
      allow read: if true;
      allow create, update: if isAdmin() || isCommunityAdmin() || isJudge();
      allow delete: if isAdmin();
    }

    match /weeklyComponentReleases/{releaseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── /elo_history/{id} ────────────────────────────────────────
    match /elo_history/{histId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Functions only
    }

    // ── /notifications/{id} ─────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create: if isAdmin(); // Cloud Functions/admin review flow
      allow delete: if false;
    }

    // ── /analytics/{id} ─────────────────────────────────────────
    match /analytics/{analyticsId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Functions only
    }

    // ── /personal_decks/{userId}/decks/{deckId} ──────────────────
    // Personal deck builder — each user owns their own sub-collection
    match /personal_decks/{userId} {
      allow read, write: if isSelf(userId);

      match /decks/{deckId} {
        allow read:   if isSelf(userId) || isAdmin() || isJudge();
        allow create: if isSelf(userId);
        allow update: if isSelf(userId);
        allow delete: if isSelf(userId) || isAdmin();
      }
    }

    // ── Collection group rules (needed for collectionGroup() queries) ─────────
    // These mirror the nested rules above but apply when querying across all paths.
    match /{path=**}/matches/{matchId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/payments/{payId} {
      allow read: if isAdmin() || (isPlayer() && resource.data.playerId == request.auth.uid);
    }
    match /{path=**}/withdrawals/{withdrawId} {
      allow read: if isAdmin()
        || (isCommunityAdmin() && resource.data.requesterId == request.auth.uid);
    }
    match /{path=**}/registrations/{regId} {
      allow read: if isAuthenticated();
    }
  }
}
